argumentnames=\"[]\" argumentdefaults=\"[]\" argumenttypes=\"[]\" warp=\"false\"></mutation></shadow></statement><next><block type=\"v5_control_if_elseif_else\" id=\"2TBmeE-G4;hGwf.CfyQ8\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" branches=\"2\"></mutation><value name=\"CONDITION1\"><block type=\"v5_sensing_pressing_controller\" id=\"?V`#^]vF:HwkPF.z7@/I\"><field name=\"CONTROLLER\">Controller1</field><field name=\"BUTTON\">ButtonR1</field></block></value><statement name=\"SUBSTACK1\"><block type=\"v5_control_if_then\" id=\".BQ#P[1}Ca-yI2tB)B4z\"><value name=\"CONDITION\"><block type=\"v5_operator_comparison\" id=\"r2K_7IH!9GJyveg@j?wC\"><field name=\"COMPARISON\">&lt;</field><value name=\"NUM1\"><shadow type=\"math_number_string\" id=\"T;Ts}#*3=;mx}mx8=zIk\"><field name=\"NUM\">0</field></shadow><block type=\"v5_variables_variable\" id=\"DRc[4:P;?PH@y+7fE:g3\"><field name=\"VARIABLE\" id=\"=fXCA0~RxlwtD(MN~s?^\">liftStateCur</field></block></value><value name=\"NUM2\"><shadow type=\"math_number_string\" id=\"b41D:9z$LbQn~C,dW19E\"><field name=\"NUM\">50</field></shadow><block type=\"v5_variables_variable\" id=\"V1Ro~.sM!7At!N/%3wLZ\"><field name=\"VARIABLE\" id=\"$xI7zrd9-S@L+}2?6uN;\">liftStateHi</field></block></value></block></value><statement name=\"SUBSTACK\"><block type=\"v5_variables_set_variable\" id=\"A[yw~T[T,)vp`Mtu,eX0\"><field name=\"VARIABLE\" id=\"=fXCA0~RxlwtD(MN~s?^\">liftStateCur</field><value name=\"VALUE\"><shadow type=\"math_number_string\" id=\"FWt,BIhZ,FD#ha2k/-[O\"><field name=\"NUM\">1</field></shadow><block type=\"v5_operator_math\" id=\"b}C!jN:~F2`+%ySbQe:j\"><field name=\"MATH\">+</field><value name=\"NUM1\"><shadow type=\"math_number\" id=\"w}i+g3P02Lt`R;NR^oCF\"><field name=\"NUM\">0</field></shadow><block type=\"v5_variables_variable\" id=\"q;gq[1CfEC}{GGJq0h|~\"><field name=\"VARIABLE\" id=\"=fXCA0~RxlwtD(MN~s?^\">liftStateCur</field></block></value><value name=\"NUM2\"><shadow type=\"math_number\" id=\"5?@DU25H:JKHzqz@3l):\"><field name=\"NUM\">1</field></shadow></value></block></value></block></statement></block></statement><value name=\"CONDITION2\"><block type=\"v5_sensing_pressing_controller\" id=\"t9ppeb`k@D!_r?lf/Si|\"><field name=\"CONTROLLER\">Controller1</field><field name=\"BUTTON\">ButtonR2</field></block></value><statement name=\"SUBSTACK2\"><block type=\"v5_control_if_then\" id=\"H]HIX!%DM1y-BK78Xp}T\"><value name=\"CONDITION\"><block type=\"v5_operator_comparison\" id=\"a-Y)Jfd*e_GzLp)*r%fN\"><field name=\"COMPARISON\">&gt;</field><value name=\"NUM1\"><shadow type=\"math_number_string\"><field name=\"NUM\">0</field></shadow><block type=\"v5_variables_variable\" id=\"O2[thu~6[y/QhSIGz!-z\"><field name=\"VARIABLE\" id=\"=fXCA0~RxlwtD(MN~s?^\">liftStateCur</field></block></value><value name=\"NUM2\"><shadow type=\"math_number_string\"><field name=\"NUM\">50</field></shadow><block type=\"v5_variables_variable\" id=\"c9g:G+yP]@%VtAH]ZI1+\"><field name=\"VARIABLE\" id=\"%XLkaI{h|d*)#^rY:yRV\">liftStateLo</field></block></value></block></value><statement name=\"SUBSTACK\"><block type=\"v5_variables_set_variable\" id=\"as61(2,/q6bL/OqHBXK?\"><field name=\"VARIABLE\" id=\"=fXCA0~RxlwtD(MN~s?^\">liftStateCur</field><value name=\"VALUE\"><shadow type=\"math_number_string\"><field name=\"NUM\">1</field></shadow><block type=\"v5_operator_math\" id=\"[+RVAxc.PJSw7?n2XLQQ\"><field name=\"MATH\">-</field><value name=\"NUM1\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"v5_variables_variable\" id=\"(?$#OPis4:G$vC23]fZ$\"><field name=\"VARIABLE\" id=\"=fXCA0~RxlwtD(MN~s?^\">liftStateCur</field></block></value><value name=\"NUM2\"><shadow type=\"math_number\" id=\"e)oeah;{Lew15!0U5|r_\"><field name=\"NUM\">1</field></shadow></value></block></value></block></statement></block></statement><statement name=\"SUBSTACK_ELSE\"><block type=\"v5_other_comment\" id=\"1%Q1D{C=th[d3KvK;GE`\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\"qJvG-E2UetKt2jBA*Xp1\"><field name=\"comment\">do nothing</field></shadow></value></block></statement></block></next></block><block type=\"procedures_definition\" id=\"d`6*qG29=99F_N)mju%F\" x=\"210\" y=\"2850\"><statement name=\"custom_block\"><shadow type=\"procedures_prototype\" id=\"q;8vQ?-~|Iaz6,wwah/u\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" proccode=\"updateLiftState\" proceduredefid=\"q;8vQ?-~|Iaz6,wwah/u\" argumentids=\"[]\" argumentnames=\"[]\" argumentdefaults=\"[]\" argumenttypes=\"[]\" warp=\"false\"></mutation></shadow></statement></block></xml>","robotConfig":[{"port":[12],"name":"FrontRightDrive","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[11],"name":"BackRightDrive","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[2],"name":"FrontLeftDrive","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[1],"name":"BackLeftDrive","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[],"name":"Controller1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"BackLeftDrive","leftDir":"false","right":"BackRightDrive","rightDir":"false","upDown":"FrontRightDrive","upDownDir":"false","xB":"FrontLeftDrive","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[3],"name":"IntakeLeft","customName":true,"deviceType":"MC55","deviceClass":"motor55","setting":{"reversed":"false","fwd":"forward","rev":"reverse","id":"partner"},"triportSourcePort":22},{"port":[4],"name":"IntakeRight","customName":true,"deviceType":"MC55","deviceClass":"motor55","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[5],"name":"Conveyor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[6],"name":"LiftLeft","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[7],"name":"LiftRight","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22}],"slot":2,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.62.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"downloadLanguage":"python","cppStatus":"true","cpp":"// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START V5 MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END V5 MACROS\n\n\n// Robot configuration code.\nmotor FrontRightDrive = motor(PORT12, ratio18_1, false);\n\nmotor BackRightDrive = motor(PORT11, ratio18_1, false);\n\nmotor FrontLeftDrive = motor(PORT2, ratio18_1, true);\n\nmotor BackLeftDrive = motor(PORT1, ratio18_1, true);\n\ncontroller Controller1 = controller(primary);\nmotor55 IntakeLeft = motor55(PORT3, false);\n\nmotor55 IntakeRight = motor55(PORT4, true);\n\nmotor Conveyor = motor(PORT5, ratio18_1, false);\n\nmotor LiftLeft = motor(PORT6, ratio18_1, false);\n\nmotor LiftRight = motor(PORT7, ratio18_1, true);\n\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  int systemTime = Brain.Timer.systemHighResolution();\n  double batteryCurrent = Brain.Battery.current();\n  double batteryVoltage = Brain.Battery.voltage(voltageUnits::mV);\n\n  // Combine these values into a single integer\n  int seed = int(batteryVoltage + batteryCurrent * 100) + systemTime;\n\n  // Set the seed\n  srand(seed);\n}\n\n\n\nvoid vexcodeInit() {\n\n  //Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n\n\n// Helper to make playing sounds from the V5 in VEXcode easier and\n// keeps the code cleaner by making it clear what is happening.\nvoid playVexcodeSound(const char *soundName) {\n  printf(\"VEXPlaySound:%s\\n\", soundName);\n  wait(5, msec);\n}\n\n\n\n// Generated code.\n\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n// define variables used for controlling motors based on controller inputs\nbool Controller1LeftShoulderControlMotorsStopped = true;\nbool Controller1RightShoulderControlMotorsStopped = true;\nbool Controller1UpDownButtonsControlMotorsStopped = true;\nbool Controller1XBButtonsControlMotorsStopped = true;\n\n// define a task that will handle monitoring inputs from Controller1\nint rc_auto_loop_function_Controller1() {\n  // process the controller input every 20 milliseconds\n  // update the motors based on the input values\n  while(true) {\n    if(RemoteControlCodeEnabled) {\n      // check the ButtonL1/ButtonL2 status to control BackLeftDrive\n      if (Controller1.ButtonL1.pressing()) {\n        BackLeftDrive.spin(forward);\n        Controller1LeftShoulderControlMotorsStopped = false;\n      } else if (Controller1.ButtonL2.pressing()) {\n        BackLeftDrive.spin(reverse);\n        Controller1LeftShoulderControlMotorsStopped = false;\n      } else if (!Controller1LeftShoulderControlMotorsStopped) {\n        BackLeftDrive.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        Controller1LeftShoulderControlMotorsStopped = true;\n      }\n      // check the ButtonR1/ButtonR2 status to control BackRightDrive\n      if (Controller1.ButtonR1.pressing()) {\n        BackRightDrive.spin(forward);\n        Controller1RightShoulderControlMotorsStopped = false;\n      } else if (Controller1.ButtonR2.pressing()) {\n        BackRightDrive.spin(reverse);\n        Controller1RightShoulderControlMotorsStopped = false;\n      } else if (!Controller1RightShoulderControlMotorsStopped) {\n        BackRightDrive.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        Controller1RightShoulderControlMotorsStopped = true;\n      }\n      // check the ButtonUp/ButtonDown status to control FrontRightDrive\n      if (Controller1.ButtonUp.pressing()) {\n        FrontRightDrive.spin(forward);\n        Controller1UpDownButtonsControlMotorsStopped = false;\n      } else if (Controller1.ButtonDown.pressing()) {\n        FrontRightDrive.spin(reverse);\n        Controller1UpDownButtonsControlMotorsStopped = false;\n      } else if (!Controller1UpDownButtonsControlMotorsStopped) {\n        FrontRightDrive.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        Controller1UpDownButtonsControlMotorsStopped = true;\n      }\n      // check the ButtonX/ButtonB status to control FrontLeftDrive\n      if (Controller1.ButtonX.pressing()) {\n        FrontLeftDrive.spin(forward);\n        Controller1XBButtonsControlMotorsStopped = false;\n      } else if (Controller1.ButtonB.pressing()) {\n        FrontLeftDrive.spin(reverse);\n        Controller1XBButtonsControlMotorsStopped = false;\n      } else if (!Controller1XBButtonsControlMotorsStopped) {\n        FrontLeftDrive.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        Controller1XBButtonsControlMotorsStopped = true;\n      }\n    }\n    // wait before repeating the process\n    wait(20, msec);\n  }\n  return 0;\n}\n\ntask rc_auto_loop_task_Controller1(rc_auto_loop_function_Controller1);\n\n// Include the V5 Library\n#include \"vex.h\"\n  \n// Allows for easier use of the VEX Library\nusing namespace vex;\n\n// User defined function\nvoid myblockfunction_stepVelocities();\n// User defined function\nvoid myblockfunction_InitializeDriverControl();\n// User defined function\nvoid myblockfunction_updateDriveVelocities();\n// User defined function\nvoid myblockfunction_setDeadZoneRadius();\n// User defined function\nvoid myblockfunction_calculateArcadeDriveVelocities();\n// User defined function\nvoid myblockfunction_calculateTankDriveVelocities();\n// User defined function\nvoid myblockfunction_scaleTargetVelocities();\n// User defined function\nvoid myblockfunction_getControllerState();\n// User defined function\nvoid myblockfunction_intakeControl();\n// User defined function\nvoid myblockfunction_initializeIntake();\n// User defined function\nvoid myblockfunction_initializeConveyor();\n// User defined function\nvoid myblockfunction_conveyorControl();\n// User defined function\nvoid myblockfunction_intializeLift();\n// User defined function\nvoid myblockfunction_liftControl();\n// User defined function\nvoid myblockfunction_updateLiftState();\n\nfloat turnsForward, maxDriveVelocity, LDVelCur, RDVelCur, deadZoneRadius, joystickPosition2, joystickPosition1, joystickPosition3, joystickPosition4, ArmVelocity, RDVelTar, LDVelTar, StepsForVelocity, IntakeRollingStates, ConveyorStates, IntakePneumaticState, LDVelNext, LDVelLast, RDVelNext, RDVelLast, intakeVelocity, conveyorVelocity, liftStateLo, liftStateMid, liftStateHi, liftStateCur;\n\n// User defined function\nvoid myblockfunction_stepVelocities() {\n  if (fabs(static_cast<float>(LDVelCur - LDVelTar)) < StepsForVelocity) {\n    LDVelNext = LDVelTar;\n  } else if (LDVelCur > LDVelTar) {\n    LDVelNext = LDVelCur - StepsForVelocity;\n  } else {\n    LDVelNext = LDVelCur + StepsForVelocity;\n  }\n  if (fabs(static_cast<float>(RDVelCur - RDVelTar)) < StepsForVelocity) {\n    RDVelNext = RDVelTar;\n  } else if (RDVelCur > RDVelTar) {\n    RDVelNext = RDVelCur - StepsForVelocity;\n  } else {\n    RDVelNext = RDVelCur + StepsForVelocity;\n  }\n}\n\n// User defined function\nvoid myblockfunction_InitializeDriverControl() {\n  StepsForVelocity = 10.0;\n  deadZoneRadius = 5.0;\n  joystickPosition1 = 0.0;\n  joystickPosition2 = 0.0;\n  joystickPosition3 = 0.0;\n  joystickPosition4 = 0.0;\n  maxDriveVelocity = 85.0;\n  RDVelCur = 0.0;\n  LDVelCur = 0.0;\n  ArmVelocity = 50.0;\n  IntakePneumaticState = 0.0;\n  ConveyorStates = 0.0;\n  IntakeRollingStates = 0.0;\n  FrontRightDrive.spin(forward);\n  BackLeftDrive.spin(forward);\n  BackRightDrive.spin(forward);\n  FrontLeftDrive.spin(forward);\n  FrontRightDrive.setStopping(coast);\n  BackRightDrive.setStopping(coast);\n  FrontLeftDrive.setStopping(coast);\n  BackLeftDrive.setStopping(coast);\n  FrontRightDrive.setVelocity(0.0, percent);\n  BackRightDrive.setVelocity(0.0, percent);\n  FrontLeftDrive.setVelocity(0.0, percent);\n  BackLeftDrive.setVelocity(0.0, percent);\n}\n\n// User defined function\nvoid myblockfunction_updateDriveVelocities() {\n  RDVelLast = RDVelCur;\n  FrontRightDrive.setVelocity(RDVelNext, percent);\n  BackRightDrive.setVelocity(RDVelNext, percent);\n  RDVelCur = RDVelNext;\n  LDVelLast = LDVelCur;\n  FrontLeftDrive.setVelocity(LDVelNext, percent);\n  BackLeftDrive.setVelocity(LDVelNext, percent);\n  LDVelCur = LDVelNext;\n}\n\n// User defined function\nvoid myblockfunction_setDeadZoneRadius() {\n  if (fabs(static_cast<float>(joystickPosition1)) < deadZoneRadius) {\n    joystickPosition1 = 0.0;\n  }\n  if (fabs(static_cast<float>(joystickPosition2)) < deadZoneRadius) {\n    joystickPosition2 = 0.0;\n  }\n  if (fabs(static_cast<float>(joystickPosition3)) < deadZoneRadius) {\n    joystickPosition3 = 0.0;\n  }\n  if (fabs(static_cast<float>(joystickPosition4)) < deadZoneRadius) {\n    joystickPosition4 = 0.0;\n  }\n}\n\n// User defined function\nvoid myblockfunction_calculateArcadeDriveVelocities() {\n  RDVelTar = joystickPosition3 + -1.0 * joystickPosition4;\n  LDVelTar = joystickPosition3 + joystickPosition4;\n}\n\n// User defined function\nvoid myblockfunction_calculateTankDriveVelocities() {\n  RDVelTar = joystickPosition2;\n  LDVelTar = joystickPosition3;\n}\n\n// User defined function\nvoid myblockfunction_scaleTargetVelocities() {\n  if (fabs(static_cast<float>(LDVelTar)) > fabs(static_cast<float>(RDVelTar))) {\n    if (fabs(static_cast<float>(LDVelTar)) > maxDriveVelocity) {\n      LDVelCur = LDVelTar * (maxDriveVelocity / fabs(static_cast<float>(LDVelTar)));\n      RDVelCur = RDVelTar * (maxDriveVelocity / fabs(static_cast<float>(LDVelTar)));\n    }\n  }\n  else {\n    if (fabs(static_cast<float>(RDVelTar)) > maxDriveVelocity) {\n      LDVelCur = LDVelTar * (maxDriveVelocity / fabs(static_cast<float>(RDVelTar)));\n      RDVelCur = RDVelTar * (maxDriveVelocity / fabs(static_cast<float>(RDVelTar)));\n    }\n  }\n}\n\n// User defined function\nvoid myblockfunction_getControllerState() {\n  joystickPosition1 = Controller1.Axis1.position();\n  joystickPosition2 = Controller1.Axis2.position();\n  joystickPosition3 = Controller1.Axis3.position();\n  joystickPosition4 = Controller1.Axis4.position();\n}\n\n// User defined function\nvoid myblockfunction_intakeControl() {\n  if (Controller1.ButtonA.pressing()) {\n    IntakeLeft.setVelocity(intakeVelocity);\n    IntakeRight.setVelocity(-(intakeVelocity));\n  } else if (Controller1.ButtonB.pressing()) {\n    IntakeLeft.setVelocity(-(intakeVelocity));\n    IntakeRight.setVelocity(intakeVelocity);\n  } else {\n    IntakeLeft.setVelocity(0.0);\n    IntakeRight.setVelocity(0.0);\n  }\n}\n\n// User defined function\nvoid myblockfunction_initializeIntake() {\n  intakeVelocity = 0.0;\n  IntakeLeft.spin(forward);\n  IntakeRight.spin(forward);\n  IntakeLeft.setStopping(coast);\n  IntakeRight.setStopping(coast);\n  IntakeLeft.setVelocity(0.0);\n  IntakeRight.setVelocity(0.0);\n}\n\n// User defined function\nvoid myblockfunction_initializeConveyor() {\n  conveyorVelocity = 0.0;\n  Conveyor.spin(forward);\n  Conveyor.setStopping(coast);\n  Conveyor.setVelocity(0.0, percent);\n}\n\n// User defined function\nvoid myblockfunction_conveyorControl() {\n  if (Controller1.ButtonX.pressing()) {\n    Conveyor.setVelocity(conveyorVelocity, percent);\n  } else if (Controller1.ButtonY.pressing()) {\n    Conveyor.setVelocity(-(conveyorVelocity), percent);\n  } else {\n    Conveyor.setVelocity(0.0, percent);\n  }\n}\n\n// User defined function\nvoid myblockfunction_intializeLift() {\n  liftStateLo = -1.0;\n  liftStateMid = 0.0;\n  liftStateHi = 1.0;\n  liftStateCur = liftStateLo;\n}\n\n// User defined function\nvoid myblockfunction_liftControl() {\n  if (Controller1.ButtonR1.pressing()) {\n    if (liftStateCur < liftStateHi) {\n      liftStateCur = liftStateCur + 1.0;\n    }\n  } else if (Controller1.ButtonR2.pressing()) {\n    if (liftStateCur > liftStateLo) {\n      liftStateCur = liftStateCur - 1.0;\n    }\n  } else {\n    // do nothing\n  }\n}\n\n// User defined function\nvoid myblockfunction_updateLiftState() {\n}\n\n// \"when started\" hat block\nint whenStarted1() {\n  myblockfunction_InitializeDriverControl();\n  myblockfunction_initializeIntake();\n  while (true) {\n    myblockfunction_getControllerState();\n    myblockfunction_calculateArcadeDriveVelocities();\n    myblockfunction_scaleTargetVelocities();\n    myblockfunction_stepVelocities();\n    myblockfunction_updateDriveVelocities();\n    myblockfunction_intakeControl();\n  wait(5, msec);\n  }\n  return 0;\n}\n\n\nint main() {\n  // Initializing Robot Configuration. DO NOT REMOVE!\n  vexcodeInit();\n\n  // post event registration\n\n  // set default print color to black\n  printf(\"\\033[30m\");\n\n  // wait for rotation sensor to fully initialize\n  wait(30, msec);\n\n  whenStarted1();\n}","target":"Physical"}
