block type=\"v5_sensing_pressing_controller\" id=\"eU/T,KZ$!f!sNso7ZijR\"><field name=\"CONTROLLER\">Controller1</field><field name=\"BUTTON\">ButtonX</field></block></value><statement name=\"SUBSTACK1\"><block type=\"v5_motion_set_motor_velocity\" id=\"jd8MKn?NfV]~`wqml(YG\"><field name=\"MOTOR\">Conveyor</field><field name=\"UNITS\">pct</field><value name=\"VELOCITY\"><shadow type=\"math_number\" id=\"Xpq0Z;Do/;qF9%P*c#^I\"><field name=\"NUM\">50</field></shadow><block type=\"v5_variables_variable\" id=\"Wj[sM*)kZn53pzu#{`y5\"><field name=\"VARIABLE\" id=\"P03P`%#?PgHj(N(n?Y_.\">conveyorVelocity</field></block></value></block></statement><value name=\"CONDITION2\"><block type=\"v5_sensing_pressing_controller\" id=\"d|;C*o,hmZmq!/(c(-3V\"><field name=\"CONTROLLER\">Controller1</field><field name=\"BUTTON\">ButtonY</field></block></value><statement name=\"SUBSTACK2\"><block type=\"v5_motion_set_motor_velocity\" id=\"E42*@A5`WY4cGO/wUIw*\"><field name=\"MOTOR\">Conveyor</field><field name=\"UNITS\">pct</field><value name=\"VELOCITY\"><shadow type=\"math_number\" id=\"wFAjRZg_BMK=`m*HOm6y\"><field name=\"NUM\">-50</field></shadow><block type=\"v5_operator_function\" id=\"r,?tep~P5?6KN+W/(L]^\"><field name=\"OPERATOR\">negate</field><value name=\"NUM\"><shadow type=\"math_number\" id=\"%#=?:8WX}SIyl]QAf.{:\"><field name=\"NUM\">0</field></shadow><block type=\"v5_variables_variable\" id=\"xnK}J+H=W8$_YqEIJfeY\"><field name=\"VARIABLE\" id=\"P03P`%#?PgHj(N(n?Y_.\">conveyorVelocity</field></block></value></block></value></block></statement><statement name=\"SUBSTACK_ELSE\"><block type=\"v5_motion_set_motor_velocity\" id=\"-]C44GOgNn;4F/j*~=Ff\"><field name=\"MOTOR\">Conveyor</field><field name=\"UNITS\">pct</field><value name=\"VELOCITY\"><shadow type=\"math_number\" id=\"C3zjZh$eO)IVIU7[9=]J\"><field name=\"NUM\">0</field></shadow></value></block></statement></block></next></block><block type=\"procedures_definition\" id=\"|p3@joNZ27h7YGwKc|Bu\" x=\"1250\" y=\"2450\"><st