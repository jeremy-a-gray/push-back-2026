rcePort":22},{"port":[4],"name":"IntakeValve","customName":true,"deviceType":"DigitalOut","deviceClass":"digital_out","setting":{"id":"partner"},"triportSourcePort":22},{"port":[5],"name":"IntakeValveLeft","customName":true,"deviceType":"DigitalOut","deviceClass":"digital_out","setting":{"id":"partner"},"triportSourcePort":22},{"port":[6],"name":"GrabberValveRight","customName":true,"deviceType":"DigitalOut","deviceClass":"digital_out","setting":{"id":"partner"},"triportSourcePort":22}],"slot":2,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.0.8","minVersion":"3.1.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"downloadLanguage":"python","cppStatus":"true","cpp":"// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START V5 MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END V5 MACROS\n\n\n// Robot configuration code.\nmotor FrontRightDrive = motor(PORT1, ratio18_1, false);\n\nmotor BackRightDrive = motor(PORT2, ratio18_1, false);\n\nmotor FrontLeftDrive = motor(PORT11, ratio18_1, true);\n\nmotor BackLeftDrive = motor(PORT12, ratio18_1, true);\n\ncontroller Controller1 = controller(primary);\nmotor LiftLeft = motor(PORT6, ratio36_1, false);\n\nmotor LiftRight = motor(PORT5, ratio36_1, true);\n\nbumper GrabberSwitch = bumper(Brain.ThreeWirePort.C);\ndigital_out GrabberValve = digital_out(Brain.ThreeWirePort.A);\nmotor IntakeDrive = motor(PORT10, ratio18_1, false);\n\nmotor ConveyorDrive = motor(PORT20, ratio18_1, false);\n\ndigital_out IntakeValve = digital_out(Brain.ThreeWirePort.D);\ndigital_out IntakeValveLeft = digital_out(Brain.ThreeWirePort.E);\ndigital_out GrabberValveRight = digital_out(Brain.ThreeWirePort.F);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  int systemTime = Brain.Timer.systemHighResolution();\n  double batteryCurrent = Brain.Battery.current();\n  double batteryVoltage = Brain.Battery.voltage(voltageUnits::mV);\n\n  // Combine these values into a single integer\n  int seed = int(batteryVoltage + batteryCurrent * 100) + systemTime;\n\n  // Set the seed\n  srand(seed);\n}\n\n\n\nvoid vexcodeInit() {\n\n  //Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n\n\n// Helper to make playing sounds from the V5 in VEXcode easier and\n// keeps the code cleaner by making it clear what is happening.\nvoid playVexcodeSound(const char *soundName) {\n  printf(\"VEXPlaySound:%s\\n\", soundName);\n  wait(5, msec);\n}\n\n\n\n// Generated code.\n\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n// define variables used for controlling motors based on controller inputs\nbool Controller1LeftShoulderControlMotorsStopped = true;\nbool Controller1RightShoulderControlMotorsStopped = true;\nbool Controller1UpDownButtonsControlMotorsStopped = true;\nbool Controller1XBButtonsControlMotorsStopped = true;\n\n// define a task that will handle monitoring inputs from Controller1\nint rc_auto_loop_function_Controller1() {\n  // process the controller input every 20 milliseconds\n  // update the motors based on the input values\n  while(true) {\n    if(RemoteControlCodeEnabled) {\n      // check the ButtonL1/ButtonL2 status to control BackLeftDrive\n      if (Controller1.ButtonL1.pressing()) {\n        BackLeftDrive.spin(forward);\n        Controller1LeftShoulderControlMotorsStopped = false;\n      } else if (Controller1.ButtonL2.pressing()) {\n        BackLeftDrive.spin(reverse);\n        Controller1LeftShoulderControlMotorsStopped = false;\n      } else if (!Controller1LeftShoulderControlMotorsStopped) {\n        BackLeftDrive.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        Controller1LeftShoulderControlMotorsStopped = true;\n      }\n      // check the ButtonR1/ButtonR2 status to control BackRightDrive\n      if (Controller1.ButtonR1.pressing()) {\n        BackRightDrive.spin(forward);\n        Controller1RightShoulderControlMotorsStopped = false;\n      } else if (Controller1.ButtonR2.pressing()) {\n        BackRightDrive.spin(reverse);\n        Controller1RightShoulderControlMotorsStopped = false;\n      } else if (!Controller1RightShoulderControlMotorsStopped) {\n        BackRightDrive.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        Controller1RightShoulderControlMotorsStopped = true;\n      }\n      // check the ButtonUp/ButtonDown status to control FrontRightDrive\n      if (Controller1.ButtonUp.pressing()) {\n        FrontRightDrive.spin(forward);\n        Controller1UpDownButtonsControlMotorsStopped = false;\n      } else if (Controller1.ButtonDown.pressing()) {\n        FrontRightDrive.spin(reverse);\n        Controller1UpDownButtonsControlMotorsStopped = false;\n      } else if (!Controller1UpDownButtonsControlMotorsStopped) {\n        FrontRightDrive.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        Controller1UpDownButtonsControlMotorsStopped = true;\n      }\n      // check the ButtonX/ButtonB status to control FrontLeftDrive\n      if (Controller1.ButtonX.pressing()) {\n        FrontLeftDrive.spin(forward);\n        Controller1XBButtonsControlMotorsStopped = false;\n      } else if (Controller1.ButtonB.pressing()) {\n        FrontLeftDrive.spin(reverse);\n        Controller1XBButtonsControlMotorsStopped = false;\n      } else if (!Controller1XBButtonsControlMotorsStopped) {\n        FrontLeftDrive.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        Controller1XBButtonsControlMotorsStopped = true;\n      }\n    }\n    // wait before repeating the process\n    wait(20, msec);\n  }\n  return 0;\n}\n\ntask rc_auto_loop_task_Controller1(rc_auto_loop_function_Controller1);\n\n// Include the V5 Library\n#include \"vex.h\"\n  \n// Allows for easier use of the VEX Library\nusing namespace vex;\n\n// User defined function\nvoid myblockfunction_stepvelocities();\n// User defined function\nvoid myblockfunction_LiftControl();\n// User defined function\nvoid myblockfunction_sensor();\n// User defined function\nvoid myblockfunction_IntakePneumatics();\n// User defined function\nvoid myblockfunction_InitializeDriverControl();\n// User defined function\nvoid myblockfunction_updateDriveVelocities();\n// User defined function\nvoid myblockfunction_Conveyor();\n// User defined function\nvoid myblockfunction_Intake();\n// User defined function\nvoid myblockfunction_calculateTankDriveVelocities();\n// User defined function\nvoid myblockfunction_calculateDriveVelocities();\n// User defined function\nvoid myblockfunction_getJoystickpositions();\n// User defined function\nvoid myblockfunction_ScaleVelocities();\n\nfloat turnsForward, MaxVelocity, LDVelCur, RDVelCur, deadZoneradius, joystickPosition2, joystickPosition1, joystickPosition3, joystickPosition4, ArmVelocity, RDVELTAR, LDVelTar, StepsForVelocity, IntakeRollingStates, ConveyorStates, IntakePneumaticState;\n\n// User defined function\nvoid myblockfunction_stepvelocities() {\n  if (fabs(static_cast<float>(LDVelCur - LDVelTar)) < StepsForVelocity) {\n    LDVelCur = LDVelTar;\n  } else if (LDVelCur > LDVelTar) {\n    LDVelCur = LDVelCur - StepsForVelocity;\n  } else {\n    LDVelCur = LDVelCur + StepsForVelocity;\n  }\n  if (fabs(static_cast<float>(RDVelCur - RDVELTAR)) < StepsForVelocity) {\n    RDVelCur = RDVELTAR;\n  } else if (RDVelCur > RDVELTAR) {\n    RDVelCur = RDVelCur - StepsForVelocity;\n  } else {\n    RDVelCur = RDVelCur + StepsForVelocity;\n  }\n}\n\n// User defined function\nvoid myblockfunction_LiftControl() {\n  if (Controller1.ButtonL2.pressing()) {\n    LiftLeft.setVelocity(50.0, percent);\n    LiftRight.setVelocity(50.0, percent);\n  } else if (Controller1.ButtonL1.pressing()) {\n    LiftLeft.setVelocity(-50.0, percent);\n    LiftRight.setVelocity(-50.0, percent);\n  } else {\n    LiftLeft.setVelocity(0.0, percent);\n    LiftRight.setVelocity(0.0, percent);\n  }\n}\n\n// User defined function\nvoid myblockfunction_sensor() {\n  if (GrabberSwitch.pressing()) {\n    GrabberValve.set(false);\n  }\n  if (Controller1.ButtonA.pressing()) {\n    GrabberValve.set(true);\n  }\n  if (Controller1.ButtonB.pressing()) {\n    GrabberValve.set(false);\n  }\n}\n\n// User defined function\nvoid myblockfunction_IntakePneumatics() {\n  if (Controller1.ButtonUp.pressing()) {\n    IntakeValve.set(true);\n  }\n  if (Controller1.ButtonDown.pressing()) {\n    IntakeValve.set(false);\n  }\n}\n\n// User defined function\nvoid myblockfunction_InitializeDriverControl() {\n  StepsForVelocity = 10.0;\n  deadZoneradius = 5.0;\n  joystickPosition1 = 0.0;\n  joystickPosition2 = 0.0;\n  joystickPosition3 = 0.0;\n  joystickPosition4 = 0.0;\n  MaxVelocity = 85.0;\n  RDVelCur = 0.0;\n  LDVelCur = 0.0;\n  ArmVelocity = 50.0;\n  IntakePneumaticState = 0.0;\n  ConveyorStates = 0.0;\n  IntakeRollingStates = 0.0;\n  ConveyorDrive.spin(forward);\n  IntakeDrive.spin(forward);\n  FrontRightDrive.spin(forward);\n  BackLeftDrive.spin(forward);\n  BackRightDrive.spin(forward);\n  FrontLeftDrive.spin(forward);\n  LiftLeft.spin(forward);\n  LiftRight.spin(forward);\n  LiftLeft.setStopping(hold);\n  LiftRight.setStopping(hold);\n  FrontRightDrive.setStopping(coast);\n  BackRightDrive.setStopping(coast);\n  FrontLeftDrive.setStopping(coast);\n  BackLeftDrive.setStopping(coast);\n  IntakeDrive.setStopping(coast);\n  ConveyorDrive.setStopping(coast);\n  FrontRightDrive.setVelocity(0.0, percent);\n  BackRightDrive.setVelocity(0.0, percent);\n  FrontLeftDrive.setVelocity(0.0, percent);\n  BackLeftDrive.setVelocity(0.0, percent);\n  LiftLeft.setVelocity(0.0, percent);\n  LiftRight.setVelocity(0.0, percent);\n  IntakeDrive.setVelocity(0.0, percent);\n  ConveyorDrive.setVelocity(0.0, percent);\n}\n\n// User defined function\nvoid myblockfunction_updateDriveVelocities() {\n  FrontRightDrive.setVelocity(RDVelCur, percent);\n  BackRightDrive.setVelocity(RDVelCur, percent);\n  BackLeftDrive.setVelocity(LDVelCur, percent);\n  FrontLeftDrive.setVelocity(LDVelCur, percent);\n}\n\n// User defined function\nvoid myblockfunction_Conveyor() {\n  if (Controller1.ButtonR1.pressing()) {\n    ConveyorDrive.setVelocity(50.0, percent);\n  } else if (Controller1.ButtonR2.pressing()) {\n    ConveyorDrive.setVelocity(-50.0, percent);\n  } else {\n    ConveyorDrive.setVelocity(0.0, percent);\n  }\n}\n\n// User defined function\nvoid myblockfunction_Intake() {\n  if (Controller1.ButtonLeft.pressing()) {\n    IntakeDrive.setVelocity(50.0, percent);\n  } else if (Controller1.ButtonRight.pressing()) {\n    IntakeDrive.setVelocity(-50.0, percent);\n  } else {\n    IntakeDrive.setVelocity(0.0, percent);\n  }\n}\n\n// User defined function\nvoid myblockfunction_calculateTankDriveVelocities() {\n  RDVelCur = joystickPosition2;\n  LDVelCur = joystickPosition3;\n}\n\n// User defined function\nvoid myblockfunction_calculateDriveVelocities() {\n  RDVelCur = joystickPosition3 + -1.0 * joystickPosition4;\n  LDVelCur = joystickPosition3 + joystickPosition4;\n}\n\n// User defined function\nvoid myblockfunction_getJoystickpositions() {\n  if (fabs(static_cast<float>(Controller1.Axis1.position())) < deadZoneradius) {\n    joystickPosition1 = 0.0;\n  }\n  else {\n    joystickPosition1 = Controller1.Axis1.position();\n  }\n  if (fabs(static_cast<float>(Controller1.Axis2.position())) < deadZoneradius) {\n    joystickPosition2 = 0.0;\n  }\n  else {\n    joystickPosition2 = Controller1.Axis2.position();\n  }\n  if (fabs(static_cast<float>(Controller1.Axis3.position())) < deadZoneradius) {\n    joystickPosition3 = 0.0;\n  }\n  else {\n    joystickPosition3 = Controller1.Axis3.position();\n  }\n  if (fabs(static_cast<float>(Controller1.Axis4.position())) < deadZoneradius) {\n    joystickPosition4 = 0.0;\n  }\n  else {\n    joystickPosition4 = Controller1.Axis4.position();\n  }\n}\n\n// User defined function\nvoid myblockfunction_ScaleVelocities() {\n  if (fabs(static_cast<float>(LDVelCur)) > fabs(static_cast<float>(RDVelCur))) {\n    if (fabs(static_cast<float>(LDVelCur)) > MaxVelocity) {\n      LDVelCur = LDVelCur * (MaxVelocity / fabs(static_cast<float>(LDVelCur)));\n      RDVelCur = RDVelCur * (MaxVelocity / fabs(static_cast<float>(LDVelCur)));\n    }\n  }\n  else {\n    if (fabs(static_cast<float>(RDVelCur)) > MaxVelocity) {\n      LDVelCur = LDVelCur * (MaxVelocity / fabs(static_cast<float>(RDVelCur)));\n      RDVelCur = RDVelCur * (MaxVelocity / fabs(static_cast<float>(RDVelCur)));\n    }\n  }\n}\n\n// \"when started\" hat block\nint whenStarted1() {\n  GrabberValve.set(true);\n  IntakeValve.set(true);\n  GrabberValveRight.set(true);\n  IntakeValveLeft.set(true);\n  myblockfunction_InitializeDriverControl();\n  while (true) {\n    myblockfunction_LiftControl();\n    myblockfunction_getJoystickpositions();\n    myblockfunction_calculateDriveVelocities();\n    myblockfunction_ScaleVelocities();\n    myblockfunction_stepvelocities();\n    myblockfunction_updateDriveVelocities();\n  wait(5, msec);\n  }\n  return 0;\n}\n\n// \"when Controller1 ButtonLeft pressed\" hat block\nvoid onevent_Controller1ButtonLeft_pressed_0() {\n  if (IntakeRollingStates == 0.0) {\n    IntakeRollingStates = 1.0;\n    IntakeDrive.setVelocity(-50.0, percent);\n  } else if (IntakeRollingStates == 1.0) {\n    IntakeRollingStates = -1.0;\n    IntakeDrive.setVelocity(50.0, percent);\n  } else {\n    IntakeRollingStates = 0.0;\n    IntakeDrive.setVelocity(0.0, percent);\n  }\n}\n\n// \"when Controller1 ButtonRight pressed\" hat block\nvoid onevent_Controller1ButtonRight_pressed_0() {\n  if (ConveyorStates == 0.0) {\n    ConveyorStates = 1.0;\n    ConveyorDrive.setVelocity(80.0, percent);\n  } else if (ConveyorStates == 1.0) {\n    ConveyorStates = -1.0;\n    ConveyorDrive.setVelocity(-50.0, percent);\n  } else {\n    ConveyorStates = 0.0;\n    ConveyorDrive.setVelocity(0.0, percent);\n  }\n}\n\n// \"when Controller1 ButtonR2 pressed\" hat block\nvoid onevent_Controller1ButtonR2_pressed_0() {\n  if (IntakePneumaticState == 0.0) {\n    ArmVelocity = 1.0;\n    IntakeValve.set(false);\n    IntakeValveLeft.set(false);\n  }\n  else {\n    ArmVelocity = 0.0;\n    IntakeValve.set(true);\n    IntakeValveLeft.set(true);\n  }\n}\n\n\nint main() {\n  // Initializing Robot Configuration. DO NOT REMOVE!\n  vexcodeInit();\n\n  // register event handlers\n  Controller1.ButtonLeft.pressed(onevent_Controller1ButtonLeft_pressed_0);\n  Controller1.ButtonRight.pressed(onevent_Controller1ButtonRight_pressed_0);\n  Controller1.ButtonR2.pressed(onevent_Controller1ButtonR2_pressed_0);\n\n  wait(15, msec);\n  // post event registration\n\n  // set default print color to black\n  printf(\"\\033[30m\");\n\n  // wait for rotation sensor to fully initialize\n  wait(30, msec);\n\n  whenStarted1();\n}","target":"Physical"}